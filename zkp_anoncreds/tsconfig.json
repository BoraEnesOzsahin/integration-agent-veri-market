{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": ["server.ts", "demo-*.ts", "src/**/*.ts"]
}