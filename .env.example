# =============================================================================
# Ayrotek Veri Marketi — Harici Kurum DMZ Düğümü Konfigürasyonu
# =============================================================================

# Merkezi Coordinator sunucusunun IP veya Domain adresi
COORDINATOR_URL=http://192.168.1.100:8081

# Bu harici makinenin yerel ağdaki IP adresi (Coordinator'ın geri dönüş için erişeceği adres)
MY_IP=192.168.1.55

# Kurum Kimliği ve Adı
NODE_ID=Banka_Harici_1
NODE_NAME=Harici Banka A.Ş. (On-Premise DMZ)

# Kurumun yerel veri tabanı ayarları
DB_NAME=institution_db
DB_USER=verimarket
DB_PASSWORD=verimarket_password
DB_PORT=5432

# Desteklenen Katalog Veri Setleri
SUPPORTED_DATASETS=gelir_gider,bankalar,finans,kredi,consortium
